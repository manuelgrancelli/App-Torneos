# Copiá este archivo a .env.local y completá los valores.
# Supabase Dashboard → Project Settings → API.

# URL del proyecto. En local (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA del proyecto: la "anon key" o la nueva "publishable key" (sb_publishable_...).
# Nunca pongas acá la service_role / secret key: esta variable llega al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
